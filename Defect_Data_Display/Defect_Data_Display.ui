    background-color: #0f3460;
    color: #eaeaea;
    border: 1px solid #0f3460;
    border-radius: 4px;
    padding: 6px 12px;
    min-width: 100px;
}
QComboBox:hover {
    background-color: #1a4d7c;
}
QComboBox::drop-down {
    border: none;
}
