           <string>
QTabWidget::pane {
    border: none;
    background-color: #16213e;
    border-radius: 8px;
}
QTabBar::tab {
    background-color: #0f3460;
    color: #888;
    padding: 8px 24px;
    margin-right: 5px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background-color: #16213e;
    color: #00d9ff;
}
QTabBar::tab:hover {
    background-color: #1a4d7c;
}
          </string>
          </property>
          <property name="currentIndex">
